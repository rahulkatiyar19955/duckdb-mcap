# MCAP test fixtures are binary. CI no longer runs on Windows, but a contributor
# cloning on a machine with core.autocrlf=true would still have these rewritten
# on checkout, corrupting the build inputs and breaking the fixture-drift check
# (`git diff --exit-code -- test/mcap`).
test/mcap/** binary
*.mcap binary

# Keep shell scripts LF for the same reason.
*.sh text eol=lf

# name: test/sql/scan.test
# description: Basic MCAP scan over the generated fixture

require mcap

statement ok
LOAD 'mcap';

query I
SELECT count(*) FROM mcap_scan('test/mcap/sample.mcap');
----
2

query T
SELECT topic FROM mcap_scan('test/mcap/sample.mcap') ORDER BY timestamp LIMIT 1;
----
/rosout

# Glob patterns expand to a multi-file scan with a filename column.
query I
SELECT count(*) FROM mcap_scan('test/mcap/*.mcap');
----
12

query I
SELECT count(DISTINCT filename) FROM mcap_scan('test/mcap/*.mcap');
----
3

# Replacement scan: FROM 'x.mcap' works directly.
query I
SELECT count(*) FROM 'test/mcap/sample.mcap';
----
2

# Parallel partitioned scan: same totals with multiple threads.
statement ok
PRAGMA threads=4;

query I
SELECT count(*) FROM mcap_scan('test/mcap/*.mcap');
----
12

query II
SELECT count(*), count(DISTINCT topic) FROM mcap_scan('test/mcap/ros2.mcap');
----
7	5
